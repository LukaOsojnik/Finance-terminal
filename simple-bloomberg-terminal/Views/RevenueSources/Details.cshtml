@using simple_bloomberg_terminal.Models.Entities
@model simple_bloomberg_terminal.Models.ViewModels.RevenueSourceDetailViewModel
@{
    var src = Model.Source;
    ViewData["Title"] = (src.Company?.Name ?? "Revenue Source") + " — " + src.Name;
    // Inline edit form posts to Edit and returns to where the user came from
    // (e.g. a company page via ?returnUrl=), falling back to this page.
    var returnTo = Context.Request.Query["returnUrl"].FirstOrDefault();
    if (string.IsNullOrEmpty(returnTo) || !Url.IsLocalUrl(returnTo)) returnTo = Context.Request.Path;
    ViewData["ReturnUrl"] = returnTo;
    ViewData["CancelUrl"] = returnTo;

    string Short(string? s, int n = 90)
    {
        s = (s ?? "").Replace("\n", " ").Trim();
        return s.Length > n ? s.Substring(0, n) + "…" : s;
    }
}

@* ── Hero ── *@
<section class="detail-hero">
    <div class="detail-hero-back">
        <a asp-controller="RevenueSources" asp-action="Index" class="detail-back-link">← REVENUE SOURCES</a>
    </div>
    <div class="detail-hero-top">
        <div class="detail-hero-name-row">
            <h1 class="detail-hero-name">@src.Name</h1>
            <span class="detail-code-badge">@src.SourceType</span>
            @if (src.Company != null)
            {
                <span class="detail-region-tag">@src.Company.Name</span>
            }
        </div>
        @if (src.DataSource.HasValue)
        {
            <div class="detail-hero-sub">SOURCE: <span class="detail-hero-accent">@src.DataSource.Value</span></div>
        }
    </div>
    <div class="detail-metrics-row">
        <div class="detail-metric-card">
            <div class="detail-metric-label">VALUE</div>
            <div class="detail-metric-value">@(src.Value.HasValue ? "$" + (src.Value.Value / 1e9).ToString("F2") + "B" : "—")</div>
        </div>
        <div class="detail-metric-card">
            <div class="detail-metric-label">SHARE OF REVENUE</div>
            <div class="detail-metric-value">@(src.Percentage.HasValue ? src.Percentage.Value.ToString("F1") + "%" : "—")</div>
        </div>
        <div class="detail-metric-card">
            <div class="detail-metric-label">PROOF</div>
            <div class="detail-metric-value">@(string.IsNullOrWhiteSpace(src.Evidence) ? "NONE" : "ON RECORD")</div>
        </div>
        <div class="detail-metric-card">
            <div class="detail-metric-label">COMPANY</div>
            <div class="detail-metric-value">@(src.Company?.Name ?? "—")</div>
        </div>
    </div>
</section>

@* ── Edit fields ── *@
<div class="detail-section-label">// EDIT FIELDS</div>
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="detail-card">
            @await Html.PartialAsync("_FieldsForm", Model.Edit)
        </div>
    </div>
</div>

@* ── Source proof: one reference + one evidence quote + the filing they came from ── *@
@{
    var proofFiling = src.Filing is { DeletedAt: null } ? src.Filing : null;
    var hasProof = !string.IsNullOrWhiteSpace(src.Reference) || !string.IsNullOrWhiteSpace(src.Evidence) || proofFiling != null;
}
<div class="detail-section-label">// SOURCE PROOF</div>
<div class="row g-3 mb-5">
    <div class="col-12">
        <div class="detail-card">
            <div class="mb-2">
                <a asp-controller="Extraction" asp-action="Index" asp-route-companyId="@src.CompanyId" asp-route-revenueSourceId="@src.Id" class="btn-detail">ADD REFERENCES →</a>
            </div>
            @if (!hasProof)
            {
                <div class="detail-pending">NO PROOF ON RECORD YET.</div>
            }
            else
            {
                <table class="terminal-table">
                    <tbody>
                        <tr>
                            <td class="tag-cell">REFERENCE</td>
                            <td class="name-cell">@(string.IsNullOrWhiteSpace(src.Reference) ? "—" : src.Reference)</td>
                        </tr>
                        <tr>
                            <td class="tag-cell">EVIDENCE</td>
                            @* Clicking the quote opens the filing it was taken from, scrolled to and
                               highlighting the passage — see wwwroot/js/evidence.js. Needs the filing
                               to still be on record; otherwise it stays plain text. *@
                            <td class="name-cell" title="@src.Evidence">
                                @if (string.IsNullOrWhiteSpace(src.Evidence))
                                {
                                    <text>—</text>
                                }
                                else if (proofFiling != null)
                                {
                                    <span class="evidence-link" role="button" tabindex="0"
                                          data-evidence="@src.Evidence"
                                          data-filing-id="@proofFiling.Id"
                                          data-sec-url="@proofFiling.PrimaryDocUrl"
                                          data-evidence-label="@src.Name — @proofFiling.Form @proofFiling.AccessionNumber">“@Short(src.Evidence, 240)”</span>
                                }
                                else
                                {
                                    <text>“@Short(src.Evidence, 240)”</text>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="tag-cell">FILING</td>
                            <td class="muted-cell">
                                @if (proofFiling != null)
                                {
                                    <a href="@proofFiling.PrimaryDocUrl" target="_blank" rel="noopener">@proofFiling.Form @proofFiling.AccessionNumber</a>
                                }
                                else
                                {
                                    <span class="muted-cell">—</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>

                <form asp-action="DetachProof" asp-route-id="@src.Id" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-detail">CLEAR PROOF</button>
                </form>
            }

            @* Point the row at one of the company's known filings (blank = no filing). *@
            <form asp-action="SetProofFiling" asp-route-id="@src.Id" method="post" class="d-flex gap-2 align-items-center mt-3">
                @Html.AntiForgeryToken()
                <label class="form-label mb-0" for="filingAccession">SOURCE FILING</label>
                <select id="filingAccession" name="filingAccession" class="form-select" style="max-width:340px;">
                    <option value="">— none —</option>
                    @foreach (var f in Model.CompanyFilings)
                    {
                        <option value="@f.AccessionNumber" selected="@(proofFiling?.AccessionNumber == f.AccessionNumber)">
                            @f.Form @f.AccessionNumber @(f.FilingDate?.ToString("yyyy-MM-dd"))
                        </option>
                    }
                </select>
                <button type="submit" class="btn-detail">SET FILING</button>
            </form>
        </div>
    </div>
</div>
